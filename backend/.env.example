# Gere uma chave: python -c 'import secrets; print(secrets.token_urlsafe(50))'
DJANGO_SECRET_KEY=substitua-por-uma-chave-gerada
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Crie o banco manualmente e configure a conexão antes de executar migrate.
DB_NAME=vacinacao
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Origens permitidas para o frontend local, separadas por vírgula.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
