# Variáveis do docker-compose.yml (sistema completo em containers).
# Copie para .env na raiz do repositório e preencha. O .env não é versionado.
# Este arquivo é diferente de backend/.env, usado no desenvolvimento sem Docker.

# Gere uma chave: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=substitua-por-uma-chave-gerada

# Banco PostgreSQL criado automaticamente pelo container na primeira execução.
DB_NAME=vacinacao
DB_USER=vacinacao
DB_PASSWORD=substitua-por-uma-senha-forte

# Endereços pelos quais o sistema será acessado, sem protocolo.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Porta do computador ou servidor em que o sistema ficará disponível.
APP_PORT=8080

# Opcional: imagens publicadas pelo GitHub Actions, para não precisar compilar no servidor.
# BACKEND_IMAGE=ghcr.io/heitor-barbosa/sistema-vacinacao-backend:latest
# FRONTEND_IMAGE=ghcr.io/heitor-barbosa/sistema-vacinacao-frontend:latest
